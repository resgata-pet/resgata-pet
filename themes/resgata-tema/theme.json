{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"palette": [
				{ "slug": "base", "color": "#FFFAF3", "name": "Creme (fundo)" },
				{ "slug": "contrast", "color": "#2E2219", "name": "Café (texto)" },
				{ "slug": "accent-1", "color": "#F7C873", "name": "Mel" },
				{ "slug": "accent-2", "color": "#F2D6C4", "name": "Pêssego" },
				{ "slug": "accent-3", "color": "#A8481F", "name": "Terracota (destaque)" },
				{ "slug": "accent-4", "color": "#6E5F54", "name": "Castanho suave" },
				{ "slug": "accent-5", "color": "#F5EBDD", "name": "Areia" },
				{ "slug": "accent-6", "color": "color-mix(in srgb, currentColor 20%, transparent)", "name": "Linha" }
			]
		}
	},
	"styles": {
		"elements": {
			"heading": {
				"typography": {
					"fontWeight": "700",
					"letterSpacing": "-0.01em"
				}
			},
			"link": {
				"color": { "text": "var:preset|color|accent-3" },
				":hover": {
					"color": { "text": "var:preset|color|contrast" }
				}
			},
			"button": {
				"border": { "radius": "999px" },
				"color": {
					"background": "var:preset|color|accent-3",
					"text": "var:preset|color|base"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|contrast",
						"text": "var:preset|color|base"
					}
				},
				":focus": {
					"outline": {
						"color": "var:preset|color|contrast",
						"offset": "2px",
						"style": "solid",
						"width": "2px"
					}
				}
			}
		}
	}
}
