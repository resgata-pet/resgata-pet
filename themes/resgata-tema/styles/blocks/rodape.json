{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Rodapé do site",
	"slug": "resgata-footer",
	"blockTypes": [
		"core/group"
	],
	"styles": {
		"border": {
			"top": {
				"color": "var:preset|color|accent-6",
