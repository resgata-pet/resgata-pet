				"right": "clamp(1.5rem, 1rem + 2vw, 2.5rem)",
				"bottom": "clamp(1.5rem, 1rem + 2vw, 2.5rem)",
				"left": "clamp(1.5rem, 1rem + 2vw, 2.5rem)"
			}
		}
	}
}
