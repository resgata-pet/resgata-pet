{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "resgata-wp/animal-details",
	"version": "0.1.0",
	"title": "Ficha do animal",
	"category": "resgata-wp",
	"icon": "id-alt",
	"description": "Mostra os dados, a saúde e a galeria de fotos do animal da página atual.",
	"keywords": [ "animal", "ficha", "saúde", "galeria" ],
	"textdomain": "resgata-wp",
	"attributes": {
		"section": {
			"type": "string",
			"enum": [ "all", "facts", "health", "gallery" ],
			"default": "all"
		}
	},
	"usesContext": [ "postId", "postType" ],
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": { "margin": true, "padding": true }
	},
	"editorScript": "rwp-blocks-editor",
	"style": "rwp-frontend",
	"render": "file:./render.php"
}
