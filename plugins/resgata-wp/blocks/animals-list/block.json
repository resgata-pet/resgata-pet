{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "resgata-wp/animals-list",
	"version": "0.1.0",
	"title": "Lista de animais",
	"category": "resgata-wp",
	"icon": "pets",
	"description": "Mostra os animais cadastrados em cartões, com filtros por espécie, sexo e porte.",
	"keywords": [ "adoção", "gatos", "cães", "animais" ],
	"textdomain": "resgata-wp",
	"attributes": {
		"species": { "type": "string", "default": "" },
		"statuses": {
			"type": "array",
			"items": { "type": "string" },
			"default": [ "available", "reserved" ]
		},
		"perPage": { "type": "number", "default": 12 },
		"columns": { "type": "number", "default": 3 },
		"showFilters": { "type": "boolean", "default": true },
		"showPagination": { "type": "boolean", "default": true }
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": { "margin": true, "padding": true }
	},
	"editorScript": "resgata-blocks-editor",
	"style": "resgata-frontend",
	"render": "file:./render.php"
}
