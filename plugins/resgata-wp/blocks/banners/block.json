{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "resgata-wp/banners",
	"version": "0.1.0",
	"title": "Banners",
	"category": "resgata-wp",
	"icon": "format-image",
	"description": "Mostra os banners escolhidos no painel (Banners), com foto, título e botões.",
	"keywords": [ "banner", "destaque", "início", "capa" ],
	"textdomain": "resgata-wp",
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": { "margin": true }
	},
	"editorScript": "rwp-blocks-editor",
	"style": "rwp-frontend",
	"render": "file:./render.php"
}
