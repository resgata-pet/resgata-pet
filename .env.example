# Copie este arquivo para .env e ajuste se necessário.
# NUNCA coloque credenciais reais aqui: somente ambiente local e chaves de sandbox.

# Portas no seu computador
WP_PORT=8080
MAILPIT_PORT=8025

# Banco de dados (apenas desenvolvimento local)
DB_NAME=resgata
DB_USER=resgata
DB_PASSWORD=resgata
DB_ROOT_PASSWORD=root

# Usuário administrador criado pelo `make install`
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.org
WP_TITLE="Protetora Exemplo"

# Usuário de teste com o perfil "Protetor admin" (só usa o /painel)
WP_PANEL_USER=protetora
WP_PANEL_PASSWORD=protetora
WP_PANEL_EMAIL=protetora@example.org

# Stripe (módulo de apadrinhamento): SOMENTE chaves de sandbox (sk_test_... ou rk_test_...).
# Crie um sandbox em https://dashboard.stripe.com/sandboxes e copie a chave dele.
STRIPE_SANDBOX_SECRET_KEY=
# Segredo de assinatura dos webhooks locais: rode `make stripe-secret` e cole aqui (whsec_...).
STRIPE_WEBHOOK_SECRET=
# Para testar o cadastro das chaves pelo painel (Configurações → Pagamentos e apadrinhamento), use 1: o site deixa de
# ler as duas chaves acima, que continuam valendo para o `make stripe`. Depois de mudar, rode `make up`.
STRIPE_KEYS_IN_PANEL=
